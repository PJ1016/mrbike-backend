{
  "info": {
    "_postman_id": "preferences-api-collection",
    "name": "Preferences Module API",
    "description": "Admin Preferences module: Campaigns, Promo Codes, Rewards & Referral, Legal, App Content.\n\nBase URL: http://localhost:8001\nMain Prefix: /bikedoctor/preferences\n\nAll requests require the `token` header (admin JWT). See PREFERENCES_API.md for full docs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8001", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "campaignId", "value": "", "type": "string" },
    { "key": "promoCodeId", "value": "", "type": "string" },
    { "key": "ruleId", "value": "", "type": "string" },
    { "key": "bannerId", "value": "", "type": "string" },
    { "key": "faqId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Campaigns",
      "item": [
        {
          "name": "List Campaigns",
          "request": {
            "method": "GET",
            "header": [{ "key": "token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/bikedoctor/preferences/campaigns",
              "host": ["{{baseUrl}}"],
              "path": ["bikedoctor", "preferences", "campaigns"]
            }
          }
        },
        {
          "name": "Get Campaign By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/bikedoctor/preferences/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bikedoctor", "preferences", "campaigns", "{{campaignId}}"]
            }
          }
        },
        {
          "name": "Get Campaign Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/bikedoctor/preferences/campaigns/{{campaignId}}/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["bikedoctor", "preferences", "campaigns", "{{campaignId}}", "analytics"]
            }
          }
        },
        {
          "name": "Create Campaign",
          "request": {
            "method": "POST",
            "header": [{ "key": "token", "value": "{{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Monsoon Service Offer", "type": "text" },
                { "key": "description", "value": "20% off on all bike services this monsoon", "type": "text" },
                { "key": "targetAudience", "value": "all", "type": "text" },
                { "key": "pushNotification", "value": "true", "type": "text" },
                { "key": "inAppNotification", "value": "true", "type": "text" },
                { "key": "scheduleAt", "value": "2026-08-01T09:00", "type": "text" },
                { "key": "status", "value": "draft", "type": "text" },
                { "key": "image", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/bikedoctor/preferences/campaigns",
              "host": ["{{baseUrl}}"],
              "path": ["bikedoctor", "preferences", "campaigns"]
            }
          }
        },
        {
          "name": "Update Campaign",
          "request": {
            "method": "PUT",
            "header": [{ "key": "token", "value": "{{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Monsoon Service Offer (Updated)", "type": "text" },
                { "key": "status", "value": "scheduled", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/bikedoctor/preferences/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bikedoctor", "preferences", "campaigns", "{{campaignId}}"]
            }
          }
        },
        {
          "name": "Toggle Campaign Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "token", "value": "{{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"active\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/bikedoctor/preferences/campaigns/{{campaignId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["bikedoctor", "preferences", "campaigns", "{{campaignId}}", "status"]
            }
          }
        },
        {
          "name": "Bulk Delete Campaigns",
          "request": {
            "method": "POST",
            "header": [{ "key": "token", "value": "{{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"ids\": [\"{{campaignId}}\"]\n}" },
            "url": {
              "raw": "{{baseUrl}}/bikedoctor/preferences/campaigns/bulk-delete",
              "host": ["{{baseUrl}}"],
              "path": ["bikedoctor", "preferences", "campaigns", "bulk-delete"]
            }
          }
        },
        {
          "name": "Bulk Update Campaign Status",
          "request": {
            "method": "POST",
            "header": [{ "key": "token", "value": "{{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"ids\": [\"{{campaignId}}\"],\n  \"status\": \"paused\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/bikedoctor/preferences/campaigns/bulk-status",
              "host": ["{{baseUrl}}"],
              "path": ["bikedoctor", "preferences", "campaigns", "bulk-status"]
            }
          }
        },
        {
          "name": "Delete Campaign",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/bikedoctor/preferences/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bikedoctor", "preferences", "campaigns", "{{campaignId}}"]
            }
          }
        }
      ]
    },
